# SeaTalk Bot Configuration
# App credentials (required) - used to auto-fetch access token
SEATALK_APP_ID=your_app_id
SEATALK_APP_SECRET=your_app_secret

# Optional: Pre-fetched access token (if not provided, will be auto-fetched)
# Token expires every 7200 seconds, so auto-fetch is recommended
SEATALK_ACCESS_TOKEN=

# Signing Secret for webhook verification (found in SeaTalk Open Platform)
# Used to verify webhook requests are actually from SeaTalk
SEATALK_SIGNING_SECRET=

# Target group chat ID (optional if bot auto-joins group)
# If not set, bot will use the first group from groups.json (auto-created when bot is added to a group)
SEATALK_GROUP_ID=your_group_id

# Google Sheets Configuration
GOOGLE_SHEET_ID=1uiy0hKwchm_SdfjTqk6IygZLArYuDnpBI45y1__pSNA

# Option 1: Local file path (for local development)
GOOGLE_SERVICE_ACCOUNT_FILE=google-service-account.json

# Option 2: Full JSON content (for Render deployment - paste entire service account JSON)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Monitoring Configuration
CHECK_INTERVAL_SECONDS=30
DELAY_BEFORE_SEND_SECONDS=5

# SeaTalk CC User IDs (comma separated)
CC_USER_IDS=1188946190,1495447455,1503543331
